{
  "name": "pilot-mcp",
  "version": "0.4.2",
  "type": "module",
  "description": "Fast browser automation MCP server for LLMs — persistent Chromium, ref-based interaction, cookie migration",
  "bin": {
    "pilot-mcp": "dist/index.js",
    "pilot": "dist/index.js",
    "pilot-cli": "dist/cli/client.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && npm run build:extension",
    "build:extension": "tsc -p extension/tsconfig.json --noEmit && node extension/build.js",
    "build:extension:watch": "node extension/build.js --watch",
    "typecheck:extension": "tsc -p extension/tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "extension/dist",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.0.0",
    "diff": "^7.0.0",
    "playwright": "^1.52.0",
    "ws": "^8.20.0",
    "zod": "^3.25.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "browser-automation",
    "playwright",
    "claude",
    "cursor",
    "ai-agent",
    "headless-browser",
    "web-automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TacosyHorchata/pilot.git"
  },
  "homepage": "https://github.com/TacosyHorchata/pilot",
  "author": "Pedro Rios",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/chrome": "^0.1.42",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
